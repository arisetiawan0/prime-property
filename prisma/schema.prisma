generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Property {
  id           String          @id @default(cuid())
  slug         String          @unique
  name         String
  area         String
  address      String          @db.Text
  price        BigInt
  type         String
  status       String          @default("in_stock")
  bedrooms     Int             @default(0)
  bathrooms    Int             @default(0)
  areaSqm      Int             @default(0)
  certificate  String
  yearBuilt    Int             @default(0)
  description  String          @db.Text
  imageUrl     String          @db.Text
  imageAlt     String          @db.Text
  isFeatured   Boolean         @default(false)
  featuredRank Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  images       PropertyImage[]
  leads        Lead[]
  agents       AgentProperty[]

  @@index([status])
  @@index([type])
  @@index([isFeatured, featuredRank])
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  url        String   @db.Text
  alt        String   @db.Text
  sortOrder  Int      @default(0)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model Lead {
  id         String      @id @default(cuid())
  name       String
  email      String
  phone      String
  subject    String
  interest   String?
  message    String      @db.Text
  propertyId String?
  status     String      @default("baru")
  createdAt  DateTime    @default(now())
  repliedAt  DateTime?
  property   Property?   @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  replies    LeadReply[]

  @@index([status])
  @@index([email])
  @@index([propertyId])
  @@index([createdAt])
}

model LeadReply {
  id        String   @id @default(cuid())
  leadId    String
  agentId   String?
  message   String   @db.Text
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agent     Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([agentId])
}

model Agent {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  phone        String
  role         String
  status       String          @default("aktif")
  passwordHash String
  avatarColor  String
  joinedAt     DateTime
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  properties   AgentProperty[]
  replies      LeadReply[]

  @@index([status])
}

model AgentProperty {
  agentId    String
  propertyId String
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([agentId, propertyId])
  @@index([propertyId])
}

model RateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime
  updatedAt DateTime @updatedAt
}
